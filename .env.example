# Copie este arquivo para as "Environment Variables" do projeto na Vercel (nao suba .env real pro Git)

# Dados do seu app, gerados quando a Shopee aprovar o cadastro de parceiro
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# Use o ambiente de testes (sandbox) primeiro, so troque para producao depois de validar tudo:
# Sandbox: https://partner.test-stable.shopeemobile.com
# Producao: https://partner.shopeemobile.com
SHOPEE_BASE_URL=https://partner.test-stable.shopeemobile.com

# URL publica do seu app + /api/callback (depois que fizer o primeiro deploy na Vercel)
# Ex: https://adaptaecom-shopee-app.vercel.app/api/callback
SHOPEE_REDIRECT_URL=

# Credenciais do banco Redis gratuito (crie em https://upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Seguranca ---

# Chave para criptografar os tokens da Shopee antes de guardar no Redis.
# Gere uma com este comando no terminal e cole o resultado aqui:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Chave para assinar o cookie de sessao do painel administrativo.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Nao existe mais uma variavel de "e-mail admin" aqui - a conta de administrador e
# criada rodando "node scripts/create-admin.js" localmente (ver README), nunca por uma
# rota publica. Isso evita alguem tentar reservar esse e-mail antes de voce.

# Segredo que so o Vercel Cron conhece, para autorizar a chamada de /api/refresh-all.
# Gere qualquer string aleatoria longa e cole tambem no dashboard da Vercel em
# Settings -> Cron Jobs (ou Environment Variables com o nome CRON_SECRET).
CRON_SECRET=

# Chave de servico usada pela tarefa agendada diaria (fora do navegador) para chamar
# /api/shop-data sem precisar logar no painel. Gere qualquer string aleatoria longa.
SERVICE_KEY=

# --- E-mail (Resend) ---

# Crie uma conta gratuita em https://resend.com e copie a API Key.
RESEND_API_KEY=

# Remetente dos e-mails - use o dominio verificado da Adaptaecom no Resend.
# Ex: "Adaptaecom <relatorios@adaptaecom.com>"
RESEND_FROM_EMAIL=

# URL publica do seu app (sem barra no final), usada nos links dos e-mails.
# Ex: https://adaptaecom-shopee-app.vercel.app
APP_BASE_URL=

# --- Analise de Oferta Relampago (20h e 22h) ---

# Estoque minimo por variacao dentro da oferta relampago. Abaixo disso, o sistema avisa
# o gestor. Padrao: 30 (conforme pedido).
FLASH_SALE_MIN_STOCK=30

# Percentual de variacao de preco (para cima OU para baixo) em relacao ao dia anterior que
# e considerado "descrepante" e dispara o aviso. Padrao: 20 (ou seja, 20%).
FLASH_SALE_PRICE_DEVIATION_PERCENT=20

# Quantas lojas os crons (refresh-all e as checagens de oferta relampago) processam ao
# mesmo tempo, em vez de uma atras da outra. Numero maior = checagem mais rapida, mas mais
# chamadas simultaneas a API da Shopee. Padrao: 8 (ver README, secao sobre tempo de execucao).
FLASH_SALE_CONCURRENCY=8
